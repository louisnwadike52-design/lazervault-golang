  "definitions": {
    "pbCreateUserRequest": {
      "type": "object",
      "properties": {
        "firstName": {
          "type": "string"
        },
        "lastName": {
          "type": "string"
        },
        "email": {
          "type": "string"
        },
        "password": {
          "type": "string"
        },
        "phoneNumber": {
          "type": "string"
        },
        "role": {
          "type": "string"
        }
      }
    },
    "pbCreateUserResponse": {
      "type": "object",
      "properties": {
        "success": {
          "type": "boolean"
        },
        "message": {
          "type": "string"
        },
        "data": {
          "$ref": "#/definitions/pbData"
        }
      }
    },
    "pbData": {
      "type": "object",
      "properties": {
        "user": {
          "$ref": "#/definitions/pbUser"
        },
        "session": {
          "$ref": "#/definitions/pbSession"
        }
      }
    },
    "pbInitiateTransferRequest": {
      "type": "object",
      "properties": {
        "toUserId": {
          "type": "string",
          "format": "uint64"
        },
        "amount": {
          "type": "number",
          "format": "double"
        },
        "category": {
          "type": "string"
        },
        "reference": {
          "type": "string",
          "title": "Optional reference"
        },
        "scheduledAt": {
          "type": "string",
          "format": "date-time",
          "title": "Optional schedule time"
        }
      },
      "title": "Request message for initiating a transfer"
    },
    "pbInitiateTransferResponse": {
      "type": "object",
      "properties": {
        "transferId": {
          "type": "string",
          "format": "uint64"
        },
        "status": {
          "type": "string"
        },
        "amount": {
          "type": "number",
          "format": "double"
        },
        "fee": {
          "type": "number",
          "format": "double"
        },
        "totalAmount": {
          "type": "number",
          "format": "double"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "title": "Response message for initiating a transfer"
    },
    "pbLoginRequest": {
      "type": "object",
      "properties": {
        "email": {
          "type": "string"
        },
        "password": {
          "type": "string"
        }
      }
    },
    "pbLoginResponse": {
      "type": "object",
      "properties": {
        "data": {
          "$ref": "#/definitions/pbData"
        },
        "success": {
          "type": "boolean"
        },
        "msg": {
          "type": "string"
        }
      }
    },
    "pbLogoutRequest": {
      "type": "object",
      "properties": {
        "sessionId": {
          "type": "string"
        }
      }
    },
    "pbLogoutResponse": {
      "type": "object",
      "properties": {
        "success": {
          "type": "boolean"
        },
        "msg": {
          "type": "string"
        }
      }
    },
    "pbRefreshTokenRequest": {
      "type": "object",
      "properties": {
        "refreshToken": {
          "type": "string"
        }
      }
    },
    "pbRefreshTokenResponse": {
      "type": "object",
      "properties": {
        "data": {
          "$ref": "#/definitions/pbData"
        },
        "success": {
          "type": "boolean"
        },
        "msg": {
          "type": "string"
        }
      }
    },
    "pbSession": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "userId": {
          "type": "string",
          "format": "uint64"
        },
        "accessToken": {
          "type": "string"
        },
        "refreshToken": {
          "type": "string"
        },
        "accessTokenExpiresAt": {
          "type": "string",
          "format": "date-time"
        },
        "refreshTokenExpiresAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "pbUser": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uint64"
        },
        "firstName": {
          "type": "string"
        },
        "lastName": {
          "type": "string"
        },
        "email": {
          "type": "string"
        },
        "phoneNumber": {
          "type": "string"
        },
        "role": {
          "type": "string"
        },
        "verified": {
          "type": "boolean"
        },
        "isEmailVerified": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "title": "Base user type"
    },
    "protobufAny": {
      "type": "object",
      "properties": {
        "@type": {
          "type": "string"
        }
      },
      "additionalProperties": {}
    },
    "rpcStatus": {
      "type": "object",
      "properties": {
        "code": {
          "type": "integer",
          "format": "int32"
        },
        "message": {
          "type": "string"
        },
        "details": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/protobufAny"
          }
        }
      }
    }
  }
}
