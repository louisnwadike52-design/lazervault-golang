package grpcApi

import (
	"context"
	"errors"
	"lazervaultGo/models"
	"lazervaultGo/pb"
	"lazervaultGo/services"
	"strconv"

	"github.com/rs/zerolog/log"
	"google.golang.org/grpc/codes"
	"google.golang.org/grpc/status"
)

// AutoSaveController handles gRPC requests related to auto-save
type AutoSaveController struct {
	pb.UnimplementedAutoSaveServiceServer // Embed for forward compatibility
	autoSaveService services.IAutoSaveService
	userService     services.IUserService
}

// NewAutoSaveController creates a new AutoSaveController
func NewAutoSaveController(autoSaveService services.IAutoSaveService, userService services.IUserService) *AutoSaveController {
	return &AutoSaveController{
		autoSaveService: autoSaveService,
		userService:     userService,
	}
}

// CreateAutoSaveRule creates a new auto-save rule
func (c *AutoSaveController) CreateAutoSaveRule(ctx context.Context, req *pb.CreateAutoSaveRuleRequest) (*pb.CreateAutoSaveRuleResponse, error) {
	log.Info().
		Str("name", req.Name).
		Str("trigger_type", req.TriggerType.String()).
		Str("amount_type", req.AmountType.String()).
		Float64("amount_value", req.AmountValue).
		Msg("CreateAutoSaveRule request received")

	user, err := getUserFromContext(ctx, c.userService)
	if err != nil {
		log.Error().Err(err).Msg("Failed to get user from context")
		return nil, err
	}

	log.Info().
		Uint("user_id", user.ID).
		Str("rule_name", req.Name).
		Msg("Creating auto-save rule")

	// Convert proto enums to model enums
	triggerType := convertProtoToTriggerType(req.TriggerType)
	amountType := convertProtoToAmountType(req.AmountType)

	// Parse account IDs
	sourceAccountID, err := parseIDToUint(req.SourceAccountId)
	if err != nil {
		return nil, err
	}
	destAccountID, err := parseIDToUint(req.DestinationAccountId)
	if err != nil {
		return nil, err
	}

	serviceReq := &services.CreateAutoSaveRuleRequest{
		Name:                 req.Name,
		Description:          req.Description,
		TriggerType:          triggerType,
		AmountType:           amountType,
		AmountValue:          req.AmountValue,
		SourceAccountID:      sourceAccountID,
		DestinationAccountID: destAccountID,
	}

	// Optional fields
	if req.Frequency != pb.ScheduleFrequency_FREQUENCY_UNKNOWN {
		freq := convertProtoToScheduleFrequency(req.Frequency)
		serviceReq.Frequency = &freq
	}
	if req.ScheduleTime != "" {
		serviceReq.ScheduleTime = &req.ScheduleTime
	}
	if req.ScheduleDay != 0 {
		day := int(req.ScheduleDay)
		serviceReq.ScheduleDay = &day
	}
	if req.RoundUpTo != 0 {
		roundUp := int(req.RoundUpTo)
		serviceReq.RoundUpTo = &roundUp
	}
	if req.TargetAmount != 0 {
		serviceReq.TargetAmount = &req.TargetAmount
	}
	if req.MinimumBalance != 0 {
		serviceReq.MinimumBalance = &req.MinimumBalance
	}
	if req.MaximumPerSave != 0 {
		serviceReq.MaximumPerSave = &req.MaximumPerSave
	}

	rule, err := c.autoSaveService.CreateAutoSaveRule(ctx, user.ID, serviceReq)
	if err != nil {
		log.Error().Err(err).
			Uint("user_id", user.ID).
			Str("rule_name", req.Name).
			Msg("Failed to create auto-save rule")
		return nil, status.Errorf(codes.Internal, "failed to create auto-save rule: %v", err)
	}

	log.Info().
		Uint("user_id", user.ID).
		Uint("rule_id", rule.ID).
		Str("rule_name", rule.Name).
		Msg("Auto-save rule created successfully")

	return &pb.CreateAutoSaveRuleResponse{
		Success: true,
		Msg:     "Auto-save rule created successfully",
		Rule:    services.ConvertAutoSaveRuleToProto(rule),
	}, nil
}

// GetAutoSaveRules retrieves auto-save rules with optional filters
func (c *AutoSaveController) GetAutoSaveRules(ctx context.Context, req *pb.GetAutoSaveRulesRequest) (*pb.GetAutoSaveRulesResponse, error) {
	user, err := getUserFromContext(ctx, c.userService)
	if err != nil {
		return nil, err
	}

	var accountID *uint
	if req.AccountId != 0 {
		id := uint(req.AccountId)
		accountID = &id
	}

	var statusFilter *models.AutoSaveStatus
	if req.Status != pb.AutoSaveStatus_STATUS_UNKNOWN {
		s := convertProtoToAutoSaveStatus(req.Status)
		statusFilter = &s
	}

	rules, err := c.autoSaveService.GetAutoSaveRules(ctx, user.ID, accountID, statusFilter)
	if err != nil {
		return nil, status.Errorf(codes.Internal, "failed to get auto-save rules: %v", err)
	}

	// Convert to proto
	protoRules := make([]*pb.AutoSaveRule, len(rules))
	for i, rule := range rules {
		protoRules[i] = services.ConvertAutoSaveRuleToProto(rule)
	}

	return &pb.GetAutoSaveRulesResponse{
		Success: true,
		Msg:     "Auto-save rules retrieved successfully",
		Rules:   protoRules,
	}, nil
}

// UpdateAutoSaveRule updates an existing auto-save rule
func (c *AutoSaveController) UpdateAutoSaveRule(ctx context.Context, req *pb.UpdateAutoSaveRuleRequest) (*pb.UpdateAutoSaveRuleResponse, error) {
	user, err := getUserFromContext(ctx, c.userService)
	if err != nil {
		return nil, err
	}

	serviceReq := &services.UpdateAutoSaveRuleRequest{}

	if req.Name != "" {
		serviceReq.Name = &req.Name
	}
	if req.Description != "" {
		serviceReq.Description = &req.Description
	}
	if req.AmountType != pb.AmountType_AMOUNT_UNKNOWN {
		amountType := convertProtoToAmountType(req.AmountType)
		serviceReq.AmountType = &amountType
	}
	if req.AmountValue != 0 {
		serviceReq.AmountValue = &req.AmountValue
	}
	if req.Frequency != pb.ScheduleFrequency_FREQUENCY_UNKNOWN {
		freq := convertProtoToScheduleFrequency(req.Frequency)
		serviceReq.Frequency = &freq
	}
	if req.ScheduleTime != "" {
		serviceReq.ScheduleTime = &req.ScheduleTime
	}
	if req.ScheduleDay != 0 {
		day := int(req.ScheduleDay)
		serviceReq.ScheduleDay = &day
	}
	if req.RoundUpTo != 0 {
		roundUp := int(req.RoundUpTo)
		serviceReq.RoundUpTo = &roundUp
	}
	if req.TargetAmount != 0 {
		serviceReq.TargetAmount = &req.TargetAmount
	}
	if req.MinimumBalance != 0 {
		serviceReq.MinimumBalance = &req.MinimumBalance
	}
	if req.MaximumPerSave != 0 {
		serviceReq.MaximumPerSave = &req.MaximumPerSave
	}

	rule, err := c.autoSaveService.UpdateAutoSaveRule(ctx, uint(req.RuleId), user.ID, serviceReq)
	if err != nil {
		if errors.Is(err, services.ErrAutoSaveRuleNotFound) {
			return nil, status.Errorf(codes.NotFound, "auto-save rule not found")
		}
		return nil, status.Errorf(codes.Internal, "failed to update auto-save rule: %v", err)
	}

	return &pb.UpdateAutoSaveRuleResponse{
		Success: true,
		Msg:     "Auto-save rule updated successfully",
		Rule:    services.ConvertAutoSaveRuleToProto(rule),
	}, nil
}

// ToggleAutoSaveRule pauses or resumes an auto-save rule
func (c *AutoSaveController) ToggleAutoSaveRule(ctx context.Context, req *pb.ToggleAutoSaveRuleRequest) (*pb.ToggleAutoSaveRuleResponse, error) {
	user, err := getUserFromContext(ctx, c.userService)
	if err != nil {
		return nil, err
	}

	rule, err := c.autoSaveService.ToggleAutoSaveRule(ctx, uint(req.RuleId), user.ID, req.Action)
	if err != nil {
		if errors.Is(err, services.ErrAutoSaveRuleNotFound) {
			return nil, status.Errorf(codes.NotFound, "auto-save rule not found")
		}
		if errors.Is(err, services.ErrAutoSaveInvalidAction) {
			return nil, status.Errorf(codes.InvalidArgument, "invalid action: %s", req.Action)
		}
		return nil, status.Errorf(codes.Internal, "failed to toggle auto-save rule: %v", err)
	}

	return &pb.ToggleAutoSaveRuleResponse{
		Success: true,
		Msg:     "Auto-save rule toggled successfully",
		Rule:    services.ConvertAutoSaveRuleToProto(rule),
	}, nil
}

// DeleteAutoSaveRule deletes an auto-save rule
func (c *AutoSaveController) DeleteAutoSaveRule(ctx context.Context, req *pb.DeleteAutoSaveRuleRequest) (*pb.DeleteAutoSaveRuleResponse, error) {
	user, err := getUserFromContext(ctx, c.userService)
	if err != nil {
		return nil, err
	}

	err = c.autoSaveService.DeleteAutoSaveRule(ctx, uint(req.RuleId), user.ID)
	if err != nil {
		if errors.Is(err, services.ErrAutoSaveRuleNotFound) {
			return nil, status.Errorf(codes.NotFound, "auto-save rule not found")
		}
		return nil, status.Errorf(codes.Internal, "failed to delete auto-save rule: %v", err)
	}

	return &pb.DeleteAutoSaveRuleResponse{
		Success: true,
		Msg:     "Auto-save rule deleted successfully",
	}, nil
}

// GetAutoSaveTransactions retrieves auto-save transaction history
func (c *AutoSaveController) GetAutoSaveTransactions(ctx context.Context, req *pb.GetAutoSaveTransactionsRequest) (*pb.GetAutoSaveTransactionsResponse, error) {
	user, err := getUserFromContext(ctx, c.userService)
	if err != nil {
		return nil, err
	}

	var ruleID *uint
	if req.RuleId != 0 {
		id := uint(req.RuleId)
		ruleID = &id
	}

	var accountID *uint
	if req.AccountId != 0 {
		id := uint(req.AccountId)
		accountID = &id
	}

	limit := 50
	if req.Limit != 0 {
		limit = int(req.Limit)
	}

	offset := 0
	if req.Offset != 0 {
		offset = int(req.Offset)
	}

	transactions, total, err := c.autoSaveService.GetAutoSaveTransactions(ctx, user.ID, ruleID, accountID, limit, offset)
	if err != nil {
		return nil, status.Errorf(codes.Internal, "failed to get auto-save transactions: %v", err)
	}

	// Convert to proto
	protoTransactions := make([]*pb.AutoSaveTransaction, len(transactions))
	for i, tx := range transactions {
		protoTransactions[i] = services.ConvertAutoSaveTransactionToProto(tx)
	}

	return &pb.GetAutoSaveTransactionsResponse{
		Success:      true,
		Msg:          "Auto-save transactions retrieved successfully",
		Transactions: protoTransactions,
		Total:        int32(total),
	}, nil
}

// GetAutoSaveStatistics retrieves auto-save statistics
func (c *AutoSaveController) GetAutoSaveStatistics(ctx context.Context, req *pb.GetAutoSaveStatisticsRequest) (*pb.GetAutoSaveStatisticsResponse, error) {
	user, err := getUserFromContext(ctx, c.userService)
	if err != nil {
		return nil, err
	}

	stats, err := c.autoSaveService.GetAutoSaveStatistics(ctx, user.ID)
	if err != nil {
		return nil, status.Errorf(codes.Internal, "failed to get auto-save statistics: %v", err)
	}

	protoStats := &pb.AutoSaveStatistics{
		UserId:              uint64(stats.UserID),
		ActiveRulesCount:    int32(stats.ActiveRulesCount),
		TotalSavedAllTime:   stats.TotalSavedAllTime,
		TotalSavedThisMonth: stats.TotalSavedThisMonth,
		TotalSavedThisWeek:  stats.TotalSavedThisWeek,
		TotalTransactions:   int32(stats.TotalTransactions),
		AverageSaveAmount:   stats.AverageSaveAmount,
	}

	if stats.MostActiveRule != nil {
		protoStats.MostActiveRule = services.ConvertAutoSaveRuleToProto(stats.MostActiveRule)
	}

	return &pb.GetAutoSaveStatisticsResponse{
		Success:    true,
		Msg:        "Auto-save statistics retrieved successfully",
		Statistics: protoStats,
	}, nil
}

// TriggerAutoSave manually triggers an auto-save rule
func (c *AutoSaveController) TriggerAutoSave(ctx context.Context, req *pb.TriggerAutoSaveRequest) (*pb.TriggerAutoSaveResponse, error) {
	user, err := getUserFromContext(ctx, c.userService)
	if err != nil {
		return nil, err
	}

	var customAmount *float64
	if req.CustomAmount != 0 {
		customAmount = &req.CustomAmount
	}

	transaction, err := c.autoSaveService.TriggerAutoSave(ctx, uint(req.RuleId), user.ID, customAmount)
	if err != nil {
		if errors.Is(err, services.ErrAutoSaveRuleNotFound) {
			return nil, status.Errorf(codes.NotFound, "auto-save rule not found")
		}
		if errors.Is(err, services.ErrAutoSaveGoalReached) {
			return nil, status.Errorf(codes.FailedPrecondition, "savings goal already reached")
		}
		if errors.Is(err, services.ErrAutoSaveInsufficientFunds) {
			return nil, status.Errorf(codes.FailedPrecondition, "insufficient funds")
		}
		return nil, status.Errorf(codes.Internal, "failed to trigger auto-save: %v", err)
	}

	return &pb.TriggerAutoSaveResponse{
		Success:     true,
		Msg:         "Auto-save triggered successfully",
		Transaction: services.ConvertAutoSaveTransactionToProto(transaction),
	}, nil
}

// Helper function to convert string ID to uint
func parseIDToUint(idStr string) (uint, error) {
	if idStr == "" || idStr == "0" {
		return 0, nil
	}
	id, err := strconv.ParseUint(idStr, 10, 32)
	if err != nil {
		return 0, status.Errorf(codes.InvalidArgument, "invalid ID format: %s", idStr)
	}
	return uint(id), nil
}

// Helper functions for enum conversion from proto to model
func convertProtoToTriggerType(t pb.TriggerType) models.TriggerType {
	switch t {
	case pb.TriggerType_TRIGGER_ON_DEPOSIT:
		return models.TriggerTypeOnDeposit
	case pb.TriggerType_TRIGGER_SCHEDULED:
		return models.TriggerTypeScheduled
	case pb.TriggerType_TRIGGER_ROUND_UP:
		return models.TriggerTypeRoundUp
	default:
		return models.TriggerTypeOnDeposit // Default
	}
}

func convertProtoToAmountType(t pb.AmountType) models.AmountType {
	switch t {
	case pb.AmountType_AMOUNT_FIXED:
		return models.AmountTypeFixed
	case pb.AmountType_AMOUNT_PERCENTAGE:
		return models.AmountTypePercentage
	default:
		return models.AmountTypeFixed // Default
	}
}

func convertProtoToAutoSaveStatus(s pb.AutoSaveStatus) models.AutoSaveStatus {
	switch s {
	case pb.AutoSaveStatus_STATUS_ACTIVE:
		return models.AutoSaveStatusActive
	case pb.AutoSaveStatus_STATUS_PAUSED:
		return models.AutoSaveStatusPaused
	case pb.AutoSaveStatus_STATUS_COMPLETED:
		return models.AutoSaveStatusCompleted
	case pb.AutoSaveStatus_STATUS_CANCELLED:
		return models.AutoSaveStatusCancelled
	default:
		return models.AutoSaveStatusActive // Default
	}
}

func convertProtoToScheduleFrequency(f pb.ScheduleFrequency) models.ScheduleFrequency {
	switch f {
	case pb.ScheduleFrequency_FREQUENCY_DAILY:
		return models.ScheduleFrequencyDaily
	case pb.ScheduleFrequency_FREQUENCY_WEEKLY:
		return models.ScheduleFrequencyWeekly
	case pb.ScheduleFrequency_FREQUENCY_BIWEEKLY:
		return models.ScheduleFrequencyBiweekly
	case pb.ScheduleFrequency_FREQUENCY_MONTHLY:
		return models.ScheduleFrequencyMonthly
	default:
		return models.ScheduleFrequencyDaily // Default
	}
}
