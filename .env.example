# Database Configuration
DB_DRIVER=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=lazervault
DB_SSLMODE=disable
DB_SOURCE=postgresql://user:password@localhost:5432/lazervault?sslmode=disable

# Server Configuration
SERVER_ADDRESS=0.0.0.0:8080
GRPC_SERVER_ADDRESS=0.0.0.0:9090
SERVER_PORT=8080
GRPC_SERVER_PORT=9090
HTTP_SERVER_PORT=8080
ENV=development

# Authentication & Security
TOKEN_SYMMETRIC_KEY=your_32_character_symmetric_key_here
ACCESS_TOKEN_DURATION=15m
REFRESH_TOKEN_DURATION=24h
VERIFICATION_CODE_DURATION=15m
PASSWORD_RESET_OTP_DURATION=15m
PASSWORD_RESET_TOKEN_EXPIRY=1h

# Redis Configuration
REDIS_SERVER_ADDR=localhost:6379

# Email Configuration (SMTP)
EMAIL_SENDER_NAME=LazerVault
EMAIL_SENDER_ADDRESS=noreply@lazervault.com
EMAIL_SENDER_PASSWORD=your_email_password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_AUTH_ADDRESS=smtp.gmail.com

# Twilio Configuration (SMS)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM_NUMBER=+1234567890

# Google Cloud Storage
GCS_BUCKET_NAME=your_gcs_bucket_name
GCS_CREDENTIALS_FILE=path/to/your/credentials.json
GOOGLE_APPLICATION_CREDENTIALS=path/to/your/credentials.json

# AI Microservice
AI_MICROSERVICE_URL=http://localhost:8000

# Frontend Configuration
FRONTEND_RESET_PASSWORD_URL=https://your-frontend-url.com/reset-password
