{
  "name": "lazervault",
  "scripts": {
    "dev": "export GOOGLE_APPLICATION_CREDENTIALS=$(pwd)/lazervault-c4d5f9e91078.json && nodemon",
    "setup": "chmod +x scripts/setup.sh && ./scripts/setup.sh && yarn run proto",
    "clean": "rm go.sum && go clean -modcache && go mod tidy && make clean",
    "install": "go mod tidy && make install-tools",
    "build": "go build -o lazervaultGolang main.go",
    "proto": "make proto",
    "start:redis:local": "redis-server --daemonize yes --port 6379",
    "start:redis:brew": "brew services start redis",
    "start:redis:background": "brew services start redis",
    "stop:redis": "brew services stop redis",
    "gcloud:login": "gcloud auth activate-service-account --key-file=lazervault-c4d5f9e91078.json", 
    "clear:redis": "redis-cli FLUSHALL"
  },
  "devDependencies": {
    "nodemon": "^3.1.9"
  }
}
