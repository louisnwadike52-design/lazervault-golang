# Core Gateway - Production Configuration

# Gateway Service
HTTP_PORT=7878
GRPC_PORT=50060
ENVIRONMENT=production

# mTLS Configuration
ENABLE_MTLS=true
CERT_DIR=/etc/tls/certs
GATEWAY_NAME=core-gateway

# Microservice Addresses (Kubernetes service names)
AUTH_SERVICE_GRPC_ADDR=auth-service:50051
ACCOUNTS_SERVICE_GRPC_ADDR=accounts-service:50052

# Logging
LOG_LEVEL=info
LOG_FORMAT=json

# CORS Configuration (will be restricted in production via AllowOrigins)
# See main.go for CORS configuration - production restricts origins
